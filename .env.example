# Layer 1 configuration. Copy to `.env` and edit.
#
# Every setting is prefixed L1_ and read via layer1.config.get_settings().

# --- database -------------------------------------------------------------
L1_DATABASE_URL=postgresql://moonbot:moonbot@localhost:5433/moonbot

# --- llm ------------------------------------------------------------------
# Which provider the four research agents call.
#   openrouter   - hosted models. RECOMMENDED. A pipeline this sequential makes
#                  many calls, and a small local model on CPU-only hardware is
#                  both slow and weak -- the worst combination for research.
#   openai       - any OpenAI-compatible endpoint (vLLM, Groq, LM Studio --
#                  anything speaking /chat/completions).
#   ollama       - local model. The fallback when hosted credit runs out.
#   deterministic - rule-based provider for tests and offline pipeline runs.
#                  NEVER selected implicitly. Artifacts it produces are
#                  stamped model_used='deterministic/v1' so they are
#                  permanently identifiable as non-LLM-derived.
L1_LLM_MODE=openrouter

# --- OpenRouter -----------------------------------------------------------
# Key from https://openrouter.ai/keys
#
# MODEL TIERS: ids ending in ':free' are restricted to approved agentic
# harnesses and reject direct API calls with HTTP 403 even from a valid key.
# A server-side pipeline needs a paid id.
L1_OPENROUTER_API_KEY=
L1_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
L1_OPENROUTER_MODEL=thinkingmachines/inkling-small
L1_OPENROUTER_APP_TITLE=moonbot-layer1
L1_OPENROUTER_SITE_URL=

# --- local fallback -------------------------------------------------------
L1_OLLAMA_BASE_URL=http://localhost:11434
L1_OLLAMA_MODEL=qwen2.5:3b-instruct

L1_LLM_TIMEOUT_S=300

# --- pipeline defaults ----------------------------------------------------
# Bump whenever prompt text changes. Two hypotheses generated with the same
# model but different prompt versions are NOT the same artifact.
L1_PROMPT_VERSION=l1-v1

# Tier used when a source does not declare one. See db/schema.sql.
L1_DEFAULT_TIER=3